{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "canvas", "name": "Canvas", "color": "#fcfcfd" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "navy", "name": "Navy", "color": "#354782" },
				{ "slug": "intro", "name": "Intro", "color": "#e9edf6" },
				{ "slug": "ink", "name": "Ink", "color": "#151517" },
				{ "slug": "text", "name": "Text", "color": "#31333a" },
				{ "slug": "muted", "name": "Muted", "color": "#dee0e7" },
				{ "slug": "link", "name": "Link", "color": "#395ac7" },
				{ "slug": "line", "name": "Line", "color": "#d6d9df" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "Inter, sans-serif",
					"name": "Inter",
					"slug": "inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-400.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-500.woff2" ]
						}
					]
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"units": [ "px", "rem", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "18px",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					}
				}
			}
		}
	}
}
